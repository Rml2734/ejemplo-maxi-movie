# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env al repositorio.
# Evita los caracteres ; = $ # y las comillas dentro de las claves.

# --- Obligatorias ---
DB_PASSWORD=cambia_esta_clave
ADMIN_PASSWORD=cambia_esta_clave

# --- Opcionales ---
ADMIN_EMAIL=admin@admin.com

# Sin GEMINI_API_KEY la aplicación funciona, pero la IA queda deshabilitada.
GEMINI_API_KEY=

# Necesarios para los correos (bienvenida y recuperación de contraseña).
# Con Gmail, usa una "contraseña de aplicación" de 16 letras, sin espacios.
SMTP_USER=
SMTP_PASSWORD=
