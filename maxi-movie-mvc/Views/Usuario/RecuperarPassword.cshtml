@{
    ViewData["Title"] = "Recuperar Contraseña";
}

<main class="flex-grow-1 d-flex align-items-center justify-content-center py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5 col-xl-4">
                <div class="card shadow-lg border-0 rounded-3">
                    <div class="card-body p-4 p-sm-5">
                        <h2 class="card-title text-center mb-3 h3 text-white">Recuperar Contraseña</h2>
                        <p class="text-muted text-center small mb-4">
                            Ingresa tu correo registrado para enviarte un enlace de recuperación.
                        </p>

                        @if (TempData["Mensaje"] != null)
                        {
                            <div class="alert alert-info small" role="alert">
                                @TempData["Mensaje"]
                            </div>
                        }

                        <form asp-controller="Usuario" asp-action="RecuperarPassword" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-4">
                                <label class="form-label text-light small fw-bold">Correo electrónico</label>
                                <input type="email" name="email" class="form-control form-control-lg text-white bg-dark border-secondary" placeholder="ejemplo@correo.com" required />
                            </div>

                            <div class="d-grid gap-2">
                                <button class="btn btn-warning btn-lg fw-bold" type="submit">Enviar enlace</button>
                                <a asp-controller="Usuario" asp-action="Login" class="btn btn-outline-secondary btn-md text-white">Volver al inicio de sesión</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>