@model maxi_movie_mvc.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Restablecer Contraseña";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card bg-dark text-white shadow-lg border-secondary rounded-3">
            <div class="card-body p-4">
                <h3 class="card-title text-center mb-3">Restablecer Contraseña</h3>
                <p class="text-muted text-center small mb-4">Ingresa tu nueva contraseña a continuación.</p>

                <form asp-action="ResetPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <!-- Campos ocultos requeridos para validar el token de Identity -->
                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-bold">Nueva Contraseña</label>
                        <input asp-for="Password" class="form-control bg-dark text-white border-secondary" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-bold">Confirmar Nueva Contraseña</label>
                        <input asp-for="ConfirmPassword" class="form-control bg-dark text-white border-secondary" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-warning fw-bold py-2">Guardar Contraseña</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}